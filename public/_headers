/* Static asset caching for better performance (Netlify _headers format) */

/* JS and CSS: long cache with fingerprinting (assumes Vite hashed filenames) */
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js, .css (root assets) */
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/* Images and fonts: long cache */
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/* HTML: short cache so we can roll out changes quickly */
/* index.html */
/
  Cache-Control: public, max-age=0, must-revalidate
